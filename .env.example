GOOGLE_API_KEY=your_google_api_key_here
DATA_CO_KR_SERVICE_KEY=your_data_go_kr_service_key_here

EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
# API key가 여러 workspace에 연결된 경우에만 설정합니다.
# LANGSMITH_WORKSPACE_ID=your_workspace_id_here
LANGSMITH_PROJECT=derma-rag

DATABASE_URL=sqlite:///./data/derma_rag.db
SQLITE_BUSY_TIMEOUT_MS=5000
PRODUCT_INGREDIENT_TTL_DAYS=90
PRODUCT_SEARCH_CACHE_TTL_MINUTES=1440
PRODUCT_COLLECTION_RETRY_BASE_SECONDS=300
PRODUCT_COLLECTION_RETRY_MAX_SECONDS=21600
PRODUCT_COLLECTION_MAX_PER_RUN=10

# 운영 기본은 true입니다. false는 로컬 개발자가 명시적으로
# 브라우저 화면을 확인해야 할 때만 사용합니다.
PRODUCT_PLAYWRIGHT_HEADLESS=false
PRODUCT_PLAYWRIGHT_TIMEOUT_MS=60000
PRODUCT_PLAYWRIGHT_DEADLINE_MS=90000
PRODUCT_PLAYWRIGHT_MAX_ATTEMPTS=2

# 수요 기반 점진적 캐시: DB MISS에서 검색 1회, 선택 상품만 상세 수집합니다.
PRODUCT_CACHE_ONLY_MODE=false
PRODUCT_LIVE_COLLECTION_ENABLED=true
# cache_only=true이면 검색/상세 MISS에서 외부 provider를 호출하지 않습니다.
# live_collection=false도 MISS provider 호출을 금지하며 자동 headed fallback은 없습니다.
# prefetch_products는 전체 상품이 아닌 인기·실제 수요 상품의 소량 최적화용입니다.

# 로컬 디버깅:
# PRODUCT_CACHE_ONLY_MODE=false
# PRODUCT_LIVE_COLLECTION_ENABLED=true
# PRODUCT_PLAYWRIGHT_HEADLESS=false
#
# 로컬/CI headless 검증:
# PRODUCT_CACHE_ONLY_MODE=false
# PRODUCT_LIVE_COLLECTION_ENABLED=true
# PRODUCT_PLAYWRIGHT_HEADLESS=true
# RUN_EXTERNAL_SMOKE_TESTS=1
